page{background:#f4f7f5;color:#172b24;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.55}view,text,input,textarea,button{box-sizing:border-box}button{margin:0;font-size:28rpx;border-radius:18rpx;line-height:1.45;padding:25rpx 28rpx}button::after{border:0}button[disabled]{opacity:.48}button.primary{background:#176f53;color:#fff;font-weight:600}button.secondary{background:#e7f0e9;color:#176147;font-weight:600}button.quiet{background:#f0f3f1;color:#4e6258}button.danger{background:#fff0e9;color:#a0432e}button.small{font-size:25rpx;padding:17rpx 22rpx}.page{padding:32rpx 30rpx 60rpx}.card{background:#fff;border:1rpx solid #e7ece8;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx}.heading{font-size:40rpx;font-weight:650;letter-spacing:-1rpx}.section-title{font-size:30rpx;font-weight:600;margin-bottom:22rpx}.muted{color:#738078}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#738078}.row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.stack{display:flex;flex-direction:column;gap:18rpx}.divider{height:1rpx;background:#e8ede9;margin:26rpx 0}.label{color:#738078;font-size:25rpx}.value{color:#172b24;text-align:right;word-break:break-all}.badge{display:inline-block;padding:7rpx 15rpx;border-radius:999rpx;background:#e8f4ed;color:#176f53;font-size:22rpx;font-weight:600;white-space:nowrap}.badge.neutral{background:#eef1ef;color:#6c7a70}.badge.warning{background:#fff2db;color:#936413}.notice{padding:23rpx 25rpx;background:#edf5ef;border-radius:16rpx;font-size:25rpx;color:#466551;margin-top:22rpx}.error{color:#a33b2b;background:#fff0ea;border-radius:16rpx;padding:24rpx;margin:24rpx 0;word-break:break-all}.empty{padding:70rpx 20rpx;text-align:center;color:#738078}.actions{display:flex;gap:18rpx;margin-top:26rpx}.actions button{flex:1}.money{font-size:54rpx;font-weight:650;letter-spacing:-1rpx}.money .currency{font-size:30rpx;margin-right:5rpx}.detail-row{display:flex;justify-content:space-between;gap:24rpx;padding:14rpx 0}.detail-row .label{flex-shrink:0}.input{width:100%;background:#f3f6f3;border:1rpx solid #e1e8e1;border-radius:14rpx;padding:22rpx 24rpx;font-size:28rpx;min-height:86rpx}.field{margin-top:24rpx}.field .label{display:block;margin-bottom:12rpx}.bottom-space{height:30rpx}.sheet-mask{position:fixed;inset:0;background:rgba(10,28,18,.45);z-index:80;display:flex;align-items:flex-end}.sheet{width:100%;max-height:90vh;overflow:auto;background:#fff;border-radius:30rpx 30rpx 0 0;padding:34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));}.sheet-title{font-size:34rpx;font-weight:600}.sheet-close{font-size:27rpx;color:#738078;padding:8rpx}.radio-option{display:flex;justify-content:space-between;align-items:center;border:2rpx solid #e5ebe6;border-radius:18rpx;padding:25rpx;margin-top:18rpx}.radio-option.selected{border-color:#176f53;background:#eff7f1}.check-row{display:flex;align-items:flex-start;gap:12rpx;font-size:25rpx;margin-top:24rpx}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}
