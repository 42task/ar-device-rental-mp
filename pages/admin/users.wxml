<view class="page">
  <view class="eyebrow">PLATFORM ACCESS</view><view class="heading">用户身份管理</view><view class="intro">设备管理员可配置租赁费用、结束租赁和办理退款。平台管理员身份受保护。</view>
  <view wx:if="{{allowed}}" class="search"><input class="input" placeholder="搜索昵称、手机号或账号 ID" value="{{search}}" bindinput="searchInput" confirm-type="search" bindconfirm="search"/><button class="secondary small" bindtap="search" disabled="{{loading || busyId !== null}}">搜索</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="quiet small retry" bindtap="retry">重新查询</button></view>
  <block wx:if="{{allowed}}">
    <view wx:for="{{items}}" wx:key="id" class="card user-card"><view class="user-main"><view class="user-name">{{item.nickname || '微信用户'}}<text class="user-id">#{{item.id}}</text></view><view class="phone">{{item.tel || '未绑定手机号'}}</view><text class="badge {{item.role === 'user' ? 'neutral' : ''}}">{{item.roleLabel}}</text></view><text wx:if="{{item.role === 'root'}}" class="protected">受保护</text><button wx:else class="small {{item.role === 'manager' ? 'quiet' : 'secondary'}}" data-index="{{index}}" bindtap="change" loading="{{busyId === item.id}}" disabled="{{busyId !== null || loading}}">{{item.role === 'manager' ? '撤销管理员' : '设为管理员'}}</button></view>
    <view wx:if="{{!items.length && !loading}}" class="empty">没有找到匹配用户</view>
    <view class="pagination"><button class="quiet small" bindtap="previous" disabled="{{page <= 1 || loading || busyId !== null}}">上一页</button><text>第 {{page}} 页 · {{total}} 人</text><button class="quiet small" bindtap="next" disabled="{{!hasMore || loading || busyId !== null}}">下一页</button></view>
  </block>
  <view wx:if="{{loading}}" class="empty">正在读取用户…</view>
</view>
