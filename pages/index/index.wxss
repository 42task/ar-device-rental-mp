.home{padding-top:22rpx}.brand{display:flex;gap:18rpx;align-items:center;margin:2rpx 0 34rpx}.brand-mark{width:76rpx;height:76rpx;background:#183d2f;color:#d6efcb;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:28rpx;font-weight:700}.brand-name{font-size:29rpx;font-weight:650}.brand-sub{color:#7b887e;font-size:22rpx;margin-top:3rpx}.hero{background:#193f30;color:#fff;border-radius:30rpx;padding:40rpx 34rpx 26rpx;margin-bottom:26rpx;overflow:hidden}.hero .eyebrow{color:#a3c7aa;font-size:20rpx}.hero-title{font-size:61rpx;line-height:1.23;letter-spacing:-2rpx;font-weight:650;margin-top:24rpx}.hero-copy{color:#bed2c4;font-size:24rpx;line-height:1.8;margin-top:24rpx}.scan-frame{height:210rpx;width:210rpx;margin:45rpx auto;position:relative;display:flex;align-items:center;justify-content:center}.scan-bracket{position:absolute;width:42rpx;height:42rpx;border-color:#bfe5a7;border-style:solid}.scan-bracket.a{top:0;left:0;border-width:4rpx 0 0 4rpx;border-radius:8rpx 0 0 0}.scan-bracket.b{top:0;right:0;border-width:4rpx 4rpx 0 0;border-radius:0 8rpx 0 0}.scan-bracket.c{bottom:0;left:0;border-width:0 0 4rpx 4rpx;border-radius:0 0 0 8rpx}.scan-bracket.d{bottom:0;right:0;border-width:0 4rpx 4rpx 0;border-radius:0 0 8rpx 0}.scan-grid{font-size:70rpx;font-weight:650;letter-spacing:4rpx;color:#c4dfc5}.scan-line{position:absolute;height:2rpx;left:-15rpx;right:-15rpx;top:110rpx;background:#d1ecb7;box-shadow:0 0 18rpx #c5e9a780}.hero button.scan-button{background:#d5edbe;color:#193f30;font-size:30rpx;padding:29rpx}.hero-foot{text-align:center;color:#b4ccbb;font-size:20rpx;margin-top:24rpx}.identity-card{padding:26rpx 30rpx}.identity-name{font-size:29rpx;font-weight:600;margin-top:7rpx}.account-id{font-size:22rpx;color:#89958c;margin-top:15rpx}.link-card{display:flex;justify-content:space-between;align-items:center;padding:27rpx 8rpx;border-bottom:1rpx solid #dfe8e1;gap:24rpx}.link-card .section-title{margin:0 0 6rpx}.link-card .muted{font-size:24rpx}.chevron{font-size:44rpx;color:#789280}.home-footer{text-align:center;font-size:19rpx;letter-spacing:4rpx;color:#a1ada4;margin:46rpx 0 0}.retry{margin-top:20rpx}
