<view class="page">
  <view wx:if="{{loading}}" class="empty">正在读取租赁信息…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="quiet small retry" bindtap="load" disabled="{{busy}}">重新查询</button></view>
  <block wx:if="{{rental}}">
    <view class="card summary"><view class="eyebrow">RENTAL ORDER</view><view class="heading">{{rental.deviceName || 'AR 设备'}}</view><text class="badge">{{rental.label}}</text><view class="uuid" selectable>{{rental.uuid}}</view></view>
    <view wx:if="{{rental.startedAt}}" class="card duration-card"><view class="label">{{rental.endedAt ? '租赁时长' : '已租时长'}}</view><view class="duration">{{elapsed}}</view><view class="detail-row"><text class="label">开始时间</text><text>{{rental.startedText}}</text></view><view wx:if="{{rental.endedAt}}" class="detail-row"><text class="label">结束时间</text><text>{{rental.endedText}}</text></view></view>
    <view class="card"><view class="section-title">支付明细</view><view class="detail-row"><text class="label">使用费</text><text>¥ {{rental.useFeeText}}</text></view><view class="detail-row"><text class="label">押金</text><text>¥ {{rental.depositText}}</text></view><view class="detail-row"><text class="label">订单合计</text><text>¥ {{rental.totalText}}</text></view><view class="divider"></view><view class="detail-row"><text class="label">订单编号</text><text class="value" selectable>{{rental.id}}</text></view><view class="detail-row"><text class="label">创建时间</text><text>{{rental.createdText}}</text></view></view>
    <view wx:if="{{rental.refundStatus}}" class="card"><view class="section-title">退款进度</view><view class="detail-row"><text class="label">退款方式</text><text>{{rental.refundMode === 'full' ? '全额退款' : '退还押金'}}</text></view><view class="detail-row"><text class="label">退款金额</text><text>¥ {{rental.refundText}}</text></view><view class="notice">{{rental.refundStatus === 'SUCCESS' ? '退款已确认成功，请查看原付款账户。' : '退款正在处理或等待处理，请以服务端查询结果为准。'}}</view><button class="secondary" bindtap="syncRefund" loading="{{busy}}" disabled="{{busy}}">查询退款状态</button></view>
    <view wx:if="{{rental.mine && rental.status === 'PENDING_PAYMENT'}}" class="card"><view class="section-title">订单等待支付</view><view class="muted">使用费与押金一次支付。若已付款，请先查询支付结果。</view><button class="primary" bindtap="pay" loading="{{busy}}" disabled="{{busy || error}}">继续支付 · ¥ {{rental.totalText}}</button><view class="actions"><button class="secondary" bindtap="syncPayment" disabled="{{busy}}">查询支付</button><button class="quiet" bindtap="cancel" disabled="{{busy}}">取消订单</button></view></view>
    <button class="quiet device-button" bindtap="device" disabled="{{busy}}">查看设备状态</button>
  </block>
</view>
